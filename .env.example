# BW Lineage Impact local runtime configuration.
# Copy to your shell/session if needed. Do not commit real values.

BW_URL="<your-bw4hana-modeling-api-base-url>"
BW_USER="<your-read-only-bw-user>"
BW_PASSWORD="<your-read-only-bw-password>"
BW_CLIENT="<your-bw-client>"
BW_LANGUAGE="EN"
BW_TRUST_ENV="true"

# Optional proxy bypass. When BW_TRUST_ENV=true, the app also appends the
# BW_URL hostname to process-local NO_PROXY before live BW calls.
NO_PROXY="<your-bw-host>,localhost,127.0.0.1"

# Optional local OpenAI-compatible LLM. Disabled unless explicitly enabled in config/CLI.
BWLI_LLM_BASE_URL="http://127.0.0.1:<port>/v1"
BWLI_LLM_MODEL="<your-local-model-name>"
BWLI_LLM_API_KEY="<your-local-llm-api-key-or-dummy-key>"
